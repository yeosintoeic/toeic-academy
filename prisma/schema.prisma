generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  name             String
  role             String          @default("STUDENT")
  plan             String          @default("NONE")
  planExpiresAt    DateTime?
  createdAt        DateTime        @default(now())
  loginAttempts    Int             @default(0)
  mustChangePw     Boolean         @default(false)
  phone            String?
  privacyConsent   Boolean         @default(false)
  marketingConsent Boolean         @default(false)
  sessionNonce     String?
  lastLoginAt      DateTime?
  captureLogs      CaptureLog[]
  savedQuestions   SavedQuestion[]
  sessions         TestSession[]
  inquiries        Inquiry[]
}

model QuestionGroup {
  id          String     @id @default(cuid())
  part        Int
  passageText String
  passageType String     @default("")
  questions   Question[]
}

model Question {
  id           String         @id @default(cuid())
  part         Int
  questionText String
  optionA      String
  optionB      String
  optionC      String
  optionD      String
  answer       String
  explanation  String         @default("")
  category     String         @default("")
  groupId       String?
  group         QuestionGroup? @relation(fields: [groupId], references: [id])
  homeworkSet   Int?
  homeworkOrder Int?
  answers       TestAnswer[]
}

model TestSession {
  id             String       @id @default(cuid())
  userId         String
  mode           String       @default("full")
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  part5Score     Int          @default(0)
  part6Score     Int          @default(0)
  part7Score     Int          @default(0)
  totalScore     Int          @default(0)
  totalQuestions Int          @default(0)
  overtimeSeconds Int         @default(0)
  answers        TestAnswer[]
  user           User         @relation(fields: [userId], references: [id])
}

model TestAnswer {
  id         String      @id @default(cuid())
  sessionId  String
  questionId String
  selected   String
  isCorrect  Boolean
  question   Question    @relation(fields: [questionId], references: [id])
  session    TestSession @relation(fields: [sessionId], references: [id])
}

model Setting {
  key   String @id
  value String
}

model RegisterCode {
  id           String   @id @default(cuid())
  code         String   @unique
  plan         String
  durationDays Int
  label        String   @default("")
  createdAt    DateTime @default(now())
}

model CaptureLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  page      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedQuestion {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  questionText String   @default("")
  sessionId    String?
  savedAt      DateTime @default(now())
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

model Lecture {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  videoUrl    String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  userId    String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
